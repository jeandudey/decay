load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")

# gcc rather than the prelude's default clang, which is not installed here.
system_cxx_toolchain(
    name = "cxx",
    compiler = "gcc",
    compiler_type = "gcc",
    cxx_compiler = "g++",
    linker = "g++",
    # The prelude puts every transitive shared library in one flat symlink
    # tree and points a single -rpath at it. GNU ld's default DT_RUNPATH is
    # not transitive, so an intermediate .so's own NEEDED entries never
    # resolve against that tree. Old-style DT_RPATH is transitive, which is
    # what the one-flat-tree design needs.
    link_flags = ["-Wl,--disable-new-dtags"],
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(name = "genrule", visibility = ["PUBLIC"])
system_python_bootstrap_toolchain(name = "python_bootstrap", visibility = ["PUBLIC"])
