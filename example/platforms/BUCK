# A worked example of configuring imported meson projects.
#
# Constraints under `//third-party/meson/constraints` come from meson itself —
# its own options, the toolchain, and what the build environment provides — and
# answer for every imported project at once. Each project's own options live
# beside its build file.
platform(
    name = "x11",
    constraint_values = [
        # Not meson's: the probes decay.toml answers from the ABI select on the
        # prelude's own constraint, so a glibc target says so here.
        "prelude//abi/constraints:abi[gnu]",
        "//third-party/meson/constraints:x11[true]",
        "//third-party/meson/constraints:egl[true]",
        "//third-party/meson/constraints:gl[true]",
        "//third-party/meson/constraints:dl[true]",
        "//third-party/meson/libepoxy/constraints:egl[yes]",
    ],
    deps = ["prelude//platforms:default"],
)

platform(
    name = "no-glx",
    constraint_values = [
        "//third-party/meson/libepoxy/constraints:glx[no]",
    ],
    deps = ["prelude//platforms:default"],
)

# No project here pins `host_machine.system`, so this selects real,
# generated Windows sources (WGL, not GLX/EGL) instead of just skipping a
# hard-coded Linux build. It cannot finish compiling yet: this repo has no
# actual Windows/MinGW `cxx_toolchain`, a separate piece of setup from
# anything decay generates.
platform(
    name = "windows",
    constraint_values = [
        "prelude//os/constraints:os[windows]",
    ],
    deps = ["prelude//platforms:default"],
)
