    cmd = "sed" + " -e ''" + select({
        "prelude//os/constraints:os[linux]": select({
            "prelude//abi/constraints:abi[gnu]": " '-es|@USE_FDS_BITS@|__fds_bits|g'",
            "DEFAULT": " '-es|@USE_FDS_BITS@|fds_bits|g'",
        }),
        "DEFAULT": " '-es|@USE_FDS_BITS@|fds_bits|g'",
    }) + select({
        "prelude//os/constraints:os[linux]": select({
            "prelude//abi/constraints:abi[gnu]": " '-es|^#mesondefine[[:space:]]\\+USE_FDS_BITS\\>.*|#define USE_FDS_BITS __fds_bits|'",
            "DEFAULT": " '-es|^#mesondefine[[:space:]]\\+USE_FDS_BITS\\>.*|#define USE_FDS_BITS fds_bits|'",
        }),
        "DEFAULT": " '-es|^#mesondefine[[:space:]]\\+USE_FDS_BITS\\>.*|#define USE_FDS_BITS fds_bits|'",
    }) + " $(location :source[include/X11/Xpoll.h.in]) > $OUT",
    visibility = ["PUBLIC"],
)

