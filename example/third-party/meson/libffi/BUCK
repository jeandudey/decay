    out = "libffi.map",
    cmd = "mkdir -p _pp_include && cp $(location :fficonfig.h) _pp_include/fficonfig.h && mkdir -p _pp_include/include && cp $(location :ffi.h) _pp_include/include/ffi.h && cp $(location :ffi.h) _pp_include/ffi.h && cc -E -P -x c -I_pp_include -I$(location :libffi) -I$(location :libffi[include]) -I$(location :libffi[src]) $(location :libffi[libffi.map.in]) -o $OUT",
    target_compatible_with = ["//third-party/meson/libffi/constraints:ffi_build_versioned[true]"],
    visibility = ["PUBLIC"],
)

