    cmd = "sed" + " -e ''" + " '-es|@PIXMAN_VERSION_MAJOR@|0|g' '-es|@PIXMAN_VERSION_MINOR@|46|g' '-es|@PIXMAN_VERSION_MICRO@|4|g'" + " '-es|^#mesondefine[[:space:]]\\+PIXMAN_VERSION_MAJOR\\>.*|#define PIXMAN_VERSION_MAJOR 0|' '-es|^#mesondefine[[:space:]]\\+PIXMAN_VERSION_MINOR\\>.*|#define PIXMAN_VERSION_MINOR 46|' '-es|^#mesondefine[[:space:]]\\+PIXMAN_VERSION_MICRO\\>.*|#define PIXMAN_VERSION_MICRO 4|'" + " $(location :pixman[pixman/pixman-version.h.in]) > $OUT",
    visibility = ["PUBLIC"],
)

