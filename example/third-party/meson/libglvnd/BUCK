# Tests declared by the meson build, as `name -> target`:
#   OpenGL symbols check -> :python3
#   EGL symbols check -> :python3
#   GLX symbols check -> :python3
#   GL symbols check -> :python3
#   GLESv1 symbols check -> :python3
#   GLESv2 symbols check -> :python3
#   gldispatch static -> :testgldispatch
#   gldispatch static thr -> :testgldispatch
#   gldispatch generated -> :testgldispatch
#   gldispatch generated end -> :testgldispatch
#   gldispatch generated thr -> :testgldispatch
#   gldispatch generated thr end -> :testgldispatch
#   gldispatch patched -> :testgldispatch
#   gldispatch patched end -> :testgldispatch
#   gldispatch patched thr -> :testgldispatch
#   gldispatch patched thr end -> :testgldispatch
#   testgldispatchthread -> :testgldispatchthread
#   glxcreatecontext -> :glxcreatecontext
#   glxmakecurrent (basic) -> :glxmakecurrent
#   glxmakecurrent (loop) -> :glxmakecurrent
#   glxmakecurrent_mt -> :glxmakecurrent_mt
#   glxmakecurrent (oldlink) -> :glxmakecurrent_oldlink
#   glxgetprocess -> :glxgetprocaddress
#   glxgetprocess_genentry -> :glxgetprocaddress
#   glxgetprocaddress_genentry -> :testglxgetprocaddress_genentry
#   glxgetclientstr -> :glxgetclientstr
#   glxgetqueryversion -> :glxqueryversion
#   egldisplay -> :egldisplay
#   egldevice -> :egldevice
#   eglgetprocaddress -> :eglgetprocaddress
#   eglmakecurrent -> :eglmakecurrent
#   eglerror -> :eglerror
#   egldebug -> :egldebug
#   egldeviceadd (querydevices) -> :egldeviceadd
#   egldeviceadd (returndevice) -> :egldeviceadd
#   egldeviceadd (querydisplay) -> :egldeviceadd
#   eglcurrentcleanup -> :eglcurrentcleanup
