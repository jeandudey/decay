#   gldispatch generated -> :testgldispatch
#   gldispatch generated end -> :testgldispatch
#   gldispatch generated thr -> :testgldispatch
#   gldispatch generated thr end -> :testgldispatch
#   gldispatch patched -> :testgldispatch
#   gldispatch patched end -> :testgldispatch
