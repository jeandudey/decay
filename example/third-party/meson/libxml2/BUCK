genrule(
    name = "libxml2-config.cmake",
    out = "libxml2-config.cmake",
    cmd = "sed" + " -e ''" + " '-es|@LIBXML_MAJOR_VERSION@|2|g' '-es|@LIBXML_MINOR_VERSION@|15|g' '-es|@LIBXML_MICRO_VERSION@|4|g' '-es|@INSTALL_BINDIR@|/usr/local/bin|g' '-es|@INSTALL_INCLUDEDIR@|/usr/local/include|g' '-es|@INSTALL_LIBDIR@|/usr/local/lib|g' '-es|@VERSION@|2.15.4|g' '-es|@BUILD_SHARED_LIBS@|1|g' '-es|@WITH_MODULES@|1|g' '-es|@WITH_THREADS@|1|g' '-es|@WITH_ZLIB@|1|g' '-es|@XML_CFLAGS@||g'" + select({
        "//third-party/meson/libxml2/constraints:iconv[enabled]": " '-es|@WITH_ICONV@|1|g'",
        "//third-party/meson/libxml2/constraints:iconv[disabled]": " '-es|@WITH_ICONV@|0|g'",
        "//third-party/meson/libxml2/constraints:iconv[auto]": " '-es|@WITH_ICONV@|1|g'",
    }) + select({
        "//third-party/meson/libxml2/constraints:icu[enabled]": " '-es|@WITH_ICU@|1|g'",
