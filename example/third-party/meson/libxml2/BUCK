genrule(
    name = "libxml2-config.cmake",
    out = "libxml2-config.cmake",
    cmd = "sed" + " -e ''" + " '-es|@LIBXML_MAJOR_VERSION@|2|g' '-es|@LIBXML_MINOR_VERSION@|15|g' '-es|@LIBXML_MICRO_VERSION@|4|g' '-es|@INSTALL_BINDIR@|/usr/local/bin|g' '-es|@INSTALL_INCLUDEDIR@|/usr/local/include|g' '-es|@INSTALL_LIBDIR@|/usr/local/lib|g' '-es|@VERSION@|2.15.4|g' '-es|@BUILD_SHARED_LIBS@|1|g' '-es|@WITH_ICONV@|1|g' '-es|@WITH_ICU@|0|g' '-es|@WITH_MODULES@|1|g' '-es|@WITH_THREADS@|1|g' '-es|@WITH_ZLIB@|1|g' '-es|@XML_CFLAGS@||g'" + " '-es|^#mesondefine[[:space:]]\\+LIBXML_MAJOR_VERSION\\>.*|#define LIBXML_MAJOR_VERSION 2|' '-es|^#mesondefine[[:space:]]\\+LIBXML_MINOR_VERSION\\>.*|#define LIBXML_MINOR_VERSION 15|' '-es|^#mesondefine[[:space:]]\\+LIBXML_MICRO_VERSION\\>.*|#define LIBXML_MICRO_VERSION 4|' '-es|^#mesondefine[[:space:]]\\+INSTALL_BINDIR\\>.*|#define INSTALL_BINDIR /usr/local/bin|' '-es|^#mesondefine[[:space:]]\\+INSTALL_INCLUDEDIR\\>.*|#define INSTALL_INCLUDEDIR /usr/local/include|' '-es|^#mesondefine[[:space:]]\\+INSTALL_LIBDIR\\>.*|#define INSTALL_LIBDIR /usr/local/lib|' '-es|^#mesondefine[[:space:]]\\+VERSION\\>.*|#define VERSION 2.15.4|' '-es|^#mesondefine[[:space:]]\\+BUILD_SHARED_LIBS\\>.*|#define BUILD_SHARED_LIBS 1|' '-es|^#mesondefine[[:space:]]\\+WITH_ICONV\\>.*|#define WITH_ICONV 1|' '-es|^#mesondefine[[:space:]]\\+WITH_ICU\\>.*|#define WITH_ICU 0|' '-es|^#mesondefine[[:space:]]\\+WITH_MODULES\\>.*|#define WITH_MODULES 1|' '-es|^#mesondefine[[:space:]]\\+WITH_THREADS\\>.*|#define WITH_THREADS 1|' '-es|^#mesondefine[[:space:]]\\+WITH_ZLIB\\>.*|#define WITH_ZLIB 1|' '-es|^#mesondefine[[:space:]]\\+XML_CFLAGS\\>.*|#define XML_CFLAGS |'" + " $(location :source[libxml2-config.cmake.in]) > $OUT",
    visibility = ["PUBLIC"],
)

