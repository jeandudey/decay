# Hand-written targets for libraries that come from the operating system.
#
# `decay.toml` maps meson's `dependency('x11')` and friends onto these, so the
# generated build files reference a real target instead of an empty stub. The
# flags are what `pkg-config --cflags --libs <name>` prints on a stock distro
# install; the headers live on the compiler's default search path.
#
# Only what nothing imported provides belongs here: GL/EGL come from
# libglvnd, zlib and libffi from their own imported projects.

# pkg-config: x11
prebuilt_cxx_library(
    name = "X11",
    header_only = True,
    exported_linker_flags = ["-lX11"],
    visibility = ["PUBLIC"],
)
