# Hand-written wrappers for build tools that come from the operating system,
# the same idea as `//third-party/system` for libraries: `decay.toml` maps
# `find_program()` onto these, so the generated build calls a real target
# instead of failing to configure at all.
#
# Each one just execs the system copy: there is no hermetic build of it in
# this repo, and nothing already imported provides it either -- unlike
# glib-compile-resources/glib-mkenums/glib-genmarshal, which glib's own
# `gobject/meson.build`/`gio/meson.build` build from source and register via
# `meson.override_find_program()`, so a consumer (harfbuzz's own
# `gnome.mkenums()`) resolves against glib's own tool automatically and
# needs no wrapper here at all.

sh_binary(
    name = "python3",
    main = "python3.sh",
    visibility = ["PUBLIC"],
)

sh_binary(
    name = "gperf",
    main = "gperf.sh",
    visibility = ["PUBLIC"],
)
